---
// A drawing of a graphics card for the GPU Corner hero: shroud, two fans, heat-sink fins,
// memory chips, the PCIe connector and the bracket. Plain shapes, no brand.
const blades = Array.from({ length: 7 }, (_, i) => i * (360 / 7));
const fans = [150, 330];
const fins = Array.from({ length: 34 }, (_, i) => 62 + i * 12);
const vram = [70, 120, 170, 330, 380, 430];
const pins = Array.from({ length: 22 }, (_, i) => 170 + i * 10);
---
<svg class="gpu-board" viewBox="0 0 520 300" role="img" aria-label="Drawing of a graphics card with two fans">
  <defs>
    <linearGradient id="gb-shroud" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#262c35" />
      <stop offset="1" stop-color="#14181e" />
    </linearGradient>
    <radialGradient id="gb-glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#8b949e" stop-opacity=".18" />
      <stop offset="1" stop-color="#8b949e" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- glow under the card -->
  <ellipse cx="270" cy="160" rx="250" ry="130" fill="url(#gb-glow)" />

  <!-- bracket -->
  <rect x="8" y="34" width="26" height="214" rx="3" class="gb-bracket" />
  {[60, 90, 120, 150, 180, 210].map((y) => <rect x="16" y={y} width="10" height="18" rx="2" class="gb-vent" />)}

  <!-- PCB -->
  <rect x="34" y="40" width="468" height="200" rx="8" class="gb-pcb" />
  <!-- memory chips along the board edge -->
  {vram.map((x) => <rect x={x} y="214" width="34" height="18" rx="2" class="gb-chip" />)}

  <!-- PCIe connector -->
  {pins.map((x) => <rect x={x} y="240" width="6" height="20" rx="1" class="gb-pin" />)}

  <!-- heat-sink fins, seen through the top of the shroud -->
  {fins.map((x) => <rect x={x} y="48" width="4" height="22" class="gb-fin" />)}

  <!-- shroud -->
  <rect x="44" y="64" width="448" height="142" rx="14" fill="url(#gb-shroud)" class="gb-shroud" />
  <path d="M60 196 H476" class="gb-stripe" />
  <text x="470" y="88" text-anchor="end" class="gb-label">GPU</text>

  <!-- fans -->
  {fans.map((cx, n) => (
    <g transform={`translate(${cx} 135)`}>
      <circle r="58" class="gb-ring" />
      <g class={`gb-fan gb-fan-${n}`}>
        {blades.map((a) => <path d="M0 -8 C 20 -14 40 -30 46 -46 C 30 -40 12 -32 -4 -18 Z" transform={`rotate(${a})`} class="gb-blade" />)}
      </g>
      <circle r="13" class="gb-hub" />
    </g>
  ))}

  <!-- labels -->
  <text x="70" y="282" class="gb-small">VRAM</text>
  <path d="M86 270 V236" class="gb-lead" />
  <text x="300" y="282" text-anchor="middle" class="gb-small">PCIe</text>
</svg>
