---
// "Get the next notebook by email" box. The email list is kept by Buttondown (set BUTTONDOWN in src/lib/site.ts).
// Buttondown sends a confirmation email first, so only people who click it are added.
// GoatCounter counts each signup as "subscribe/<where>", so you can see which page brings people in.
import { BUTTONDOWN } from '../lib/site';
type Props = { where: string };
const { where } = Astro.props;
const id = `bd-email-${where.replace(/[^a-z0-9]+/gi, '-')}`;
// On your laptop (npm run dev) the box always shows, so you can see it before BUTTONDOWN is set.
// The live site only shows it once BUTTONDOWN is set.
const show = BUTTONDOWN || import.meta.env.DEV;
const preview = !BUTTONDOWN;
---
{show && (
  <aside class="subscribe">
    <h2>Get the next notebook by email</h2>
    <p>One email when a new notebook or a big update comes out. Nothing else, and you can leave with one click.</p>
    <form action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN || 'your-username'}`} method="post" target="_blank" data-where={where}>
      <label for={id} class="sr">Your email address</label>
      <input type="email" name="email" id={id} placeholder="you@example.com" required autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">Send me the next one</button>
    </form>
    <p class="sub-done" role="status" hidden><b>Check your inbox.</b> Click the link in the email from Buttondown to finish signing up. If it isn't there in a few minutes, look in your spam folder.</p>
    <small>Buttondown keeps the list. You'll get an email to confirm first.</small>
    {preview && <p class="sub-preview">Preview on your laptop only. Set BUTTONDOWN in src/lib/site.ts to show this box on the live site.</p>}
  </aside>
)}
{show && <script is:inline>
  // Sends the address to Buttondown in the background and shows "Check your inbox" in the box,
  // so readers stay on the page. Without JavaScript the form opens Buttondown's page in a new tab instead.
  document.querySelectorAll('.subscribe form').forEach(function (f) {
    f.addEventListener('submit', function (e) {
      if (!window.fetch) return;
      e.preventDefault();
      var btn = f.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      fetch(f.action, { method: 'POST', body: new FormData(f), mode: 'no-cors' }).then(function () {
        f.hidden = true;
        f.parentNode.querySelector('.sub-done').hidden = false;
        if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path: 'subscribe/' + f.dataset.where, title: 'Email signup', event: true });
      }).catch(function () {
        btn.disabled = false;
        btn.textContent = 'Send me the next one';
        f.submit();
      });
    });
  });
</script>}
