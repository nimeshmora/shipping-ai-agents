---
// "Where I share this in person". Everything on it comes from src/lib/talks.ts. Styles are in src/styles/hub.css.
// side: the sticky side column on wide screens. Its "Want to speak too?" button sits under the heading so it is always in view.
// Without side: the full-width section at the top on smaller screens.
import { talks, pastTalks, highlights, profiles } from '../lib/talks';
import StageCta from './StageCta.astro';
const { side = false } = Astro.props as { side?: boolean };
const id = side ? 'in-person-side' : 'in-person';
const links = profiles.filter((p) => p.url);
const upcoming = talks.filter((t) => t.upcoming);
---
<section class={side ? 'talks-card side' : 'talks-card wide'} aria-labelledby={id}>
  <header class="tc-head">
    <p class="tc-eyebrow"><span class="tc-dot" aria-hidden="true"></span>In person</p>
    <h2 id={id}>Where I share this in person</h2>
    <p class="tc-sub">Talks, workshops and programs where I teach this material.</p>
    {side && <StageCta />}
  </header>

  <div class="tc-body">
    <div class="tc-block tc-upcoming">
      <h3 class="tc-label">Coming up</h3>
      <ol class="tc-list">
        {upcoming.map((t) => (
          <li class="tc-item">
            <div class="tc-item-top">
              <span class="tc-host">{t.host}</span>
              <span class="tc-when">{t.date ?? 'Date soon'}</span>
            </div>
            <p class="tc-what">{t.title}</p>
            {t.detail && <p class="tc-detail">{t.detail}</p>}
            {t.link && <a class="tc-more" href={t.link}>Details</a>}
          </li>
        ))}
      </ol>
    </div>

    <div class="tc-block tc-past">
      <div class="tc-stat">
        <b>{pastTalks.count}</b>
        <span>talks since {pastTalks.since}<small>Conferences, meetups, universities and schools</small></span>
      </div>
      <h3 class="tc-label">Past highlights</h3>
      <ul class="tc-tags">
        {highlights.map((h) => <li title={`${h.host}: ${h.what}`}>{h.short}</li>)}
      </ul>
      {links.length > 0 && <p class="tc-links">See more on {links.map((l, i) => <>{i > 0 && (i === links.length - 1 ? ' and ' : ', ')}<a href={l.url}>{l.name}</a></>)}.</p>}
      {!side && <StageCta />}
    </div>
  </div>
</section>
