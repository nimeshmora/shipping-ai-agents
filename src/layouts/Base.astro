---
import '../styles/notebook.css';
import '../styles/site.css';
import { url } from '../lib/url';
import { allChapters, readingOrder, chapterHref } from '../lib/chapters';
import { notebook as findNotebook } from '../lib/notebooks';
import { GOATCOUNTER, REPO } from '../lib/site';
// The logo (Botley shipping out on a boat) is the favicon too, so there is one file to change.
import logo from '../../public/favicon.svg?raw';

// page="hub" is the site front page: no notebook sidebar and no Previous / Next.
// Every other page belongs to a notebook (its slug, for example "shipping-ai-agents").
const { title, page, description, notebook: nbSlug } = Astro.props as { title: string; page: string; description?: string; notebook?: string };
const hub = page === 'hub';
// The front page can add a side column (slot "aside"). It only shows on wide screens; see site.css.
const rail = hub && Astro.slots.has('aside');
const nb = hub ? null : findNotebook(nbSlug ?? '');
const chapters = nb ? await allChapters(nb.slug) : [];
const order = nb ? await readingOrder(nb.slug) : [];
// Pages are remembered as read per notebook, for example "shipping-ai-agents/ch-3".
const key = (id: string) => `${nb?.slug}/${id}`;
const i = order.findIndex((o) => o.id === page);
const prev = i > 0 ? order[i - 1] : null;
const next = i >= 0 && i < order.length - 1 ? order[i + 1] : null;
const parts: string[] = [];
chapters.forEach((c) => { if (!parts.includes(c.data.part)) parts.push(c.data.part); });
const fullTitle = hub ? 'Ship It with Nimesha' : page === 'cover' ? `${nb!.title} | Ship It with Nimesha` : `${title} | ${nb!.title}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description ?? 'Ship It with Nimesha: Head First style notebooks about taking AI agents from prototype to production on AWS, Microsoft Azure and Google Cloud.'} />
  <meta name="author" content="Nimesha Jinarajadasa" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=JetBrains+Mono&family=Kalam:wght@400;700&family=Permanent+Marker&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,700;1,8..60,400&display=swap" />
  <script is:inline>
    try { var s = JSON.parse(localStorage.getItem('sai-notebook') || '{}'); if (s.theme) document.documentElement.setAttribute('data-theme', s.theme); } catch (e) {}
  </script>
  {import.meta.env.PROD && GOATCOUNTER && (
    <script is:inline async data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
  )}
</head>
<body data-page={hub ? 'hub' : key(page)}>
  <header class="bar">
    {!hub && <button id="menu" aria-controls="toc" aria-expanded="false">Contents</button>}
    <a class="brand" href={url()}><span class="logo" aria-hidden="true" set:html={logo} /><span>Ship It <i>with Nimesha</i></span></a>
    <span class="where">{hub ? 'Notebooks on deploying AI agents' : page === 'cover' ? `Notebook #${nb!.number}: ${nb!.title}` : <>{nb!.title} <span class="dot">&middot;</span> {title}</>}</span>
    <button id="theme" aria-label="Switch to dark mode">
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg>
      <span class="lbl">Go dark</span>
    </button>
  </header>
  <div class={hub ? (rail ? 'layout hub has-rail' : 'layout hub') : 'layout'}>
    {!hub && <nav class="toc" id="toc" aria-label="Contents">
      <a class="tohub" href={url()}>&larr; Ship It with Nimesha</a>
      <h2>{nb!.title}</h2>
      <ol>
        <li><a href={url(`notebooks/${nb!.slug}/`)} data-v={key('cover')} aria-current={page === 'cover' ? 'page' : undefined}><span class="n">&#9733;</span><span>Notebook cover</span><span class="ok"></span></a></li>
        <li><a href={url(`notebooks/${nb!.slug}/how/`)} data-v={key('how')} aria-current={page === 'how' ? 'page' : undefined}><span class="n">?</span><span>How to use this notebook</span><span class="ok">&#10003;</span></a></li>
        {parts.map((part, pi) => (
          <>
            {pi > 0 && <li class="sep">{part}</li>}
            {chapters.filter((c) => c.data.part === part).map((c) => (
              <li><a href={url(chapterHref(c.id))} data-v={key(`ch-${c.data.number}`)} aria-current={page === `ch-${c.data.number}` ? 'page' : undefined}>
                <span class="n">{c.data.number}</span><span>{c.data.title}</span><span class="ok">&#10003;</span></a></li>
            ))}
          </>
        ))}
        <li><a href={url(`notebooks/${nb!.slug}/back/`)} data-v={key('back')} aria-current={page === 'back' ? 'page' : undefined}><span class="n">A</span><span>Word list and answers</span><span class="ok">&#10003;</span></a></li>
      </ol>
    </nav>}
    <main>
      <article class="paper">
        <slot />
        {!hub && page !== 'cover' && (
          <nav class="pagenav" aria-label="Previous and next">
            {prev && <a class="prev" href={url(prev.href)}>Previous<b>{prev.label}</b></a>}
            {next && <a class="next" href={url(next.href)}>Next<b>{next.label}</b></a>}
          </nav>
        )}
      </article>
      <slot name="after" />
      {!hub && <p class="foot">Cloud services for agents change fast. This notebook describes them as of October 2026. Always check each provider's latest documents before you decide.</p>}
      <p class="foot">Found a mistake or have an example to share? <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Help improve the notebooks</a>. Text and drawings are shared under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>.</p>
    </main>
    {rail && <aside class="rail" aria-label="Where I share this in person"><slot name="aside" /></aside>}
  </div>
  <script is:inline>
  (function () {
    var KEY = 'sai-notebook', root = document.documentElement, page = document.body.getAttribute('data-page');
    var st = { read: [], last: null, theme: null };
    try { var o = JSON.parse(localStorage.getItem(KEY) || '{}'); st.read = o.read || []; st.last = o.last || null; st.theme = o.theme || null; } catch (e) {}
    function save() { try { localStorage.setItem(KEY, JSON.stringify(st)); } catch (e) {} }
    function paint() { document.querySelectorAll('.toc a[data-v]').forEach(function (a) { a.classList.toggle('read', st.read.indexOf(a.getAttribute('data-v')) > -1); }); }
    if (page !== 'hub' && !/\/cover$/.test(page)) { st.last = location.pathname; save(); }
    paint();
    // Tells GoatCounter that someone scrolled to the end of this page (once per reader, per page).
    function finished() { if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path: 'finished/' + page, title: 'Finished: ' + document.title, event: true }); }
    var end = document.querySelector('.pagenav');
    if (end && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting && st.read.indexOf(page) < 0) { st.read.push(page); save(); paint(); finished(); } }); }).observe(end);
    }
    var resume = document.getElementById('resume');
    if (resume && st.last && st.last !== location.pathname) { resume.hidden = false; resume.href = st.last; }
    var themeBtn = document.getElementById('theme');
    function isDark() { return root.getAttribute('data-theme') === 'dark' || (!root.getAttribute('data-theme') && matchMedia('(prefers-color-scheme: dark)').matches); }
    // The button names the mode you would switch to: "Go dark" in light mode, "Go light" in dark mode.
    function label() {
      var dark = isDark();
      themeBtn.classList.toggle('is-dark', dark);
      themeBtn.querySelector('.lbl').textContent = dark ? 'Go light' : 'Go dark';
      themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    }
    label();
    themeBtn.onclick = function () {
      st.theme = isDark() ? 'light' : 'dark'; root.setAttribute('data-theme', st.theme); save(); label();
    };
    var toc = document.getElementById('toc'), menu = document.getElementById('menu'), scrim = null;
    if (!toc || !menu) return;
    function close() { toc.classList.remove('open'); menu.setAttribute('aria-expanded', 'false'); if (scrim) { scrim.remove(); scrim = null; } }
    menu.onclick = function () {
      if (toc.classList.contains('open')) return close();
      toc.classList.add('open'); menu.setAttribute('aria-expanded', 'true');
      scrim = document.createElement('div'); scrim.className = 'scrim'; scrim.onclick = close; document.body.appendChild(scrim);
    };
    document.addEventListener('keydown', function (e) {
      if (e.target.closest && e.target.closest('input, textarea')) return;
      if (e.key === 'Escape') close();
      var a = e.key === 'ArrowRight' ? document.querySelector('.pagenav .next') : e.key === 'ArrowLeft' ? document.querySelector('.pagenav .prev') : null;
      if (a) location.href = a.href;
    });
  })();
  </script>
</body>
</html>
