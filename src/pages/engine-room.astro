---
// The Engine Room: the site's GPU corner. Linked from the front page and the KodeBox pop-up.
// It has its own hardware look (GPU green, always dark), set in src/styles/hub.css under
// "GPU Corner". The KodeBox link is set in src/lib/site.ts.
import Base from '../layouts/Base.astro';
import GpuBoard from '../components/GpuBoard.astro';
import { url } from '../lib/url';
import { KODEBOX, REPO } from '../lib/site';

// 01 Boot check: run these in order on a new GPU server.
const checks = [
  { t: 'Driver', code: 'nvidia-smi',
    ok: 'The GPU’s name and its memory, for example <code>0MiB / 23034MiB</code>.',
    no: '<code>command not found</code> means the NVIDIA driver is not installed.' },
  { t: 'Memory size', code: 'nvidia-smi --query-gpu=name,memory.total --format=csv',
    ok: 'The total memory. Put it in the fit check below.',
    no: 'An error here usually means the driver is too old.' },
  { t: 'PyTorch', code: 'python3 -c "import torch; print(torch.cuda.is_available())"',
    ok: '<code>True</code>.',
    no: '<code>False</code> means PyTorch was installed without CUDA, or the driver is too old for it.' },
  { t: 'A model on the GPU', code: 'ollama run llama3.2:3b "hi"\nollama ps',
    ok: 'The PROCESSOR column says <code>100% GPU</code>.',
    no: 'CPU, or a split like <code>40%/60% CPU/GPU</code>, means the model did not fit in GPU memory.' },
  { t: 'Under load', code: 'watch -n 1 nvidia-smi',
    ok: 'GPU use stays high while a job runs.',
    no: 'If it keeps dropping to 0%, the GPU is waiting for data. Speed up your data loading.' },
  { t: 'Kubernetes', code: 'kubectl get nodes -o custom-columns=NAME:.metadata.name,GPUS:.status.allocatable.nvidia\\.com/gpu',
    ok: 'A number in the GPUS column.',
    no: '<code>&lt;none&gt;</code> means the NVIDIA device plugin (part of the GPU Operator) is not running on that node.' },
];

// 03 The Guest Rack: projects readers built or ran on a GPU. Add new ones at the top.
// Each one comes from a "Guest Rack" issue on GitHub.
const guests: { title: string; by: string; gpu: string; what: string; link: string }[] = [];
const RACK_UNITS = 4;
const empty = Math.max(0, RACK_UNITS - guests.length);

// 04 Manuals: chapters to read first.
const manuals = [
  { nb: 'running-your-own-models', ch: '04-meet-the-gpu', from: 'Running Your Own Models · 4', title: 'Meet the GPU' },
  { nb: 'inside-the-machine', ch: '06-the-gpu', from: 'Inside the Machine · 6', title: 'The GPU' },
  { nb: 'inside-the-machine', ch: '07-the-real-bottleneck', from: 'Inside the Machine · 7', title: 'The real bottleneck' },
  { nb: 'inside-the-machine', ch: '11-reading-a-gpu-spec-sheet', from: 'Inside the Machine · 11', title: 'How to read a GPU spec sheet' },
  { nb: 'running-your-own-models', ch: '07-models-on-kubernetes', from: 'Running Your Own Models · 7', title: 'Models on Kubernetes' },
  { nb: 'inside-the-machine', ch: '08-when-one-gpu-isnt-enough', from: 'Inside the Machine · 8', title: 'When one GPU isn’t enough' },
];
---
<Base title="The Engine Room: Nimesha's GPU Corner" page="hub" where="Nimesha's GPU Corner" description="The GPU corner of Ship It with Nimesha: a boot check for a new GPU server, a check for whether a model fits in GPU memory, readers' GPU projects and the chapters to read first.">
  <div slot="top" class="band hero-band er-band">
    <div class="wrap">
      <section class="hero er-hero">
        <div class="er-hero-text">
          <p class="eyebrow">Nimesha's GPU Corner</p>
          <h1 class="hero-title">The Engine Room</h1>
          <p class="hero-sub">For people who train, fine-tune or serve models on a GPU after office hours.</p>
          <nav class="er-jump" aria-label="On this page">
            <a href="#boot"><span>01</span>Boot check</a>
            <a href="#fit"><span>02</span>Will it fit?</a>
            <a href="#rack"><span>03</span>Guest Rack</a>
            <a href="#manuals"><span>04</span>Manuals</a>
          </nav>
        </div>
        <GpuBoard />
      </section>
    </div>
  </div>

  <section class="er-kb" aria-labelledby="kb-title">
    <img src={url('kodebox-mark.png')} width="72" height="76" alt="KodeBox logo" />
    <div class="er-kb-text">
      <p class="er-kb-tag">Where I run my GPU work</p>
      <h2 id="kb-title">KodeBox</h2>
      <p>My Macs have no NVIDIA GPU. A KodeBox is a server from KodeKloud that keeps running after I close my laptop, with a GPU when I need one. I trained and fine-tuned a small model on one, and ran a Kubernetes cluster where several pods share one GPU.</p>
    </div>
    <a class="btn primary" href={KODEBOX} target="_blank" rel="sponsored noopener" data-kb="engine-room">Start a KodeBox</a>
  </section>

  <section class="er-section" aria-labelledby="boot">
    <header class="er-head">
      <span class="er-idx">01</span>
      <h2 id="boot">Boot check</h2>
      <p class="er-status" id="boot-status" aria-live="polite"><b id="boot-n">0</b> / {checks.length} passed</p>
    </header>
    <p class="er-lead">Six checks for a new GPU server, in order. Tick each one when it passes.</p>
    <ol class="boot" id="boot-list">
      {checks.map((c, i) => (
        <li class="boot-row">
          <label class="boot-led">
            <input type="checkbox" data-i={i} aria-label={`${c.t} passed`} />
            <span aria-hidden="true"></span>
          </label>
          <div class="boot-name"><span class="boot-no">{String(i + 1).padStart(2, '0')}</span>{c.t}</div>
          <div class="er-term"><pre><code>{c.code.split('\n').map((l) => <span class="ln">{l}</span>)}</code></pre></div>
          <p class="boot-ok"><span>Expect</span><span set:html={c.ok} /></p>
          <details class="boot-no-pass"><summary>If not</summary><p set:html={c.no} /></details>
        </li>
      ))}
    </ol>
  </section>

  <section class="er-section" aria-labelledby="fit">
    <header class="er-head">
      <span class="er-idx">02</span>
      <h2 id="fit">Will it fit?</h2>
    </header>
    <p class="er-lead">Each parameter takes 2 bytes at 16-bit, 1 at 8-bit and half a byte at 4-bit. Add about 20% for the KV cache and the runtime.</p>
    <form class="fit" id="fit-form" onsubmit="return false">
      <label>Model size (billions of parameters)
        <input type="number" id="fit-b" min="0.1" max="1000" step="0.1" value="8" inputmode="decimal" />
      </label>
      <label>Precision
        <select id="fit-p">
          <option value="2">16-bit (FP16 or BF16)</option>
          <option value="1">8-bit</option>
          <option value="0.5">4-bit</option>
        </select>
      </label>
      <label>GPU memory (GB)
        <input type="number" id="fit-g" min="1" max="1000" step="1" value="24" inputmode="numeric" />
      </label>
      <div class="vram" aria-hidden="true">
        <div class="vram-head"><span>VRAM</span><span id="fit-read">19 / 24 GB</span></div>
        <div class="vram-bar"><span id="fit-bar" style="width:80%"></span></div>
      </div>
      <output class="fit-out" id="fit-out" for="fit-b fit-p fit-g">An 8B model at 16-bit needs about 19 GB. It fits in 24 GB.</output>
    </form>
    <p class="small">A rough check for running a model. Full fine-tuning needs about 16 bytes per parameter, which is why most people fine-tune with LoRA or QLoRA.</p>
  </section>

  <section class="er-section" aria-labelledby="rack">
    <header class="er-head">
      <span class="er-idx">03</span>
      <h2 id="rack">The Guest Rack</h2>
    </header>
    <p class="er-lead">Projects readers built or ran on a GPU. Each one gets a slot in the rack.</p>
    <div class="rack">
      <div class="rack-top" aria-hidden="true"><span>RACK 01</span><span>GUEST PROJECTS</span><span>{guests.length} / {RACK_UNITS} U</span></div>
      <ul class="rack-units">
        {guests.map((g, i) => (
          <li class="ru on">
            <span class="ru-u" aria-hidden="true">U{i + 1}</span>
            <span class="ru-led" aria-hidden="true"></span>
            <div class="ru-body">
              <a class="ru-title" href={g.link}>{g.title}</a>
              <span class="ru-meta">{g.by} <span aria-hidden="true">·</span> {g.gpu}</span>
              <span class="ru-what">{g.what}</span>
            </div>
          </li>
        ))}
        {Array.from({ length: empty }, (_, i) => (
          <li class="ru off">
            <span class="ru-u" aria-hidden="true">U{guests.length + i + 1}</span>
            <span class="ru-led" aria-hidden="true"></span>
            <div class="ru-body">
              <span class="ru-title">Empty slot</span>
              <span class="ru-meta">Your GPU project could go here</span>
            </div>
            <span class="ru-vents" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rack-cta">
      <p>Built something on a GPU? A fine-tune, a served model, a cluster that shares one GPU.</p>
      <a class="btn primary" href={`${REPO}/issues/new?template=gpu-project.yml`}>Claim a slot</a>
    </div>
  </section>

  <section class="er-section" aria-labelledby="manuals">
    <header class="er-head">
      <span class="er-idx">04</span>
      <h2 id="manuals">Manuals</h2>
    </header>
    <p class="er-lead">Chapters from the notebooks to read before you rent a GPU.</p>
    <ol class="manuals">
      {manuals.map((m) => (
        <li><a href={url(`notebooks/${m.nb}/${m.ch}/`)}><span class="mn-from">{m.from}</span><b>{m.title}</b><span class="mn-go" aria-hidden="true">&rarr;</span></a></li>
      ))}
    </ol>
  </section>

  <script is:inline>
  // Boot check: ticked steps are kept in this browser.
  (function () {
    var list = document.getElementById('boot-list'); if (!list) return;
    var boxes = list.querySelectorAll('input[type=checkbox]'), n = document.getElementById('boot-n'), KEY = 'er-boot', done = [];
    try { done = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
    function sync() {
      var c = 0;
      boxes.forEach(function (b) { b.closest('.boot-row').classList.toggle('pass', b.checked); if (b.checked) c++; });
      n.textContent = c;
      document.getElementById('boot-status').classList.toggle('all', c === boxes.length);
    }
    boxes.forEach(function (b) {
      b.checked = done.indexOf(+b.dataset.i) >= 0;
      b.addEventListener('change', function () {
        var d = []; boxes.forEach(function (x) { if (x.checked) d.push(+x.dataset.i); });
        try { localStorage.setItem(KEY, JSON.stringify(d)); } catch (e) {}
        sync();
      });
    });
    sync();
  })();

  // Will it fit? Weights = parameters x bytes per parameter, plus about 20% for the KV cache and runtime.
  (function () {
    var b = document.getElementById('fit-b'), p = document.getElementById('fit-p'), g = document.getElementById('fit-g'), out = document.getElementById('fit-out'), bar = document.getElementById('fit-bar'), read = document.getElementById('fit-read');
    if (!b) return;
    var names = { '2': '16-bit', '1': '8-bit', '0.5': '4-bit' };
    function fmt(n) { return n >= 10 ? Math.round(n) : Math.round(n * 10) / 10; }
    function run() {
      var bn = parseFloat(b.value), bytes = parseFloat(p.value), gb = parseFloat(g.value);
      if (!(bn > 0) || !(gb > 0)) { out.textContent = 'Type a model size and a GPU memory size.'; out.className = 'fit-out'; bar.style.width = '0'; read.textContent = ''; return; }
      var need = bn * bytes * 1.2, state = 'ok';
      var line = 'A ' + fmt(bn) + 'B model at ' + names[p.value] + ' needs about ' + fmt(need) + ' GB. ';
      if (need <= gb * 0.9) line += 'It fits in ' + fmt(gb) + ' GB.';
      else if (need <= gb) { line += 'It just fits in ' + fmt(gb) + ' GB, with little room for long conversations.'; state = 'tight'; }
      else {
        state = 'no';
        line += 'It does not fit in ' + fmt(gb) + ' GB.';
        line += bytes > 0.5 ? ' Try a smaller precision.' : ' Try a smaller model or a GPU with more memory.';
      }
      out.textContent = line;
      out.className = 'fit-out ' + state;
      bar.style.width = Math.min(100, need / gb * 100) + '%';
      bar.className = state;
      read.textContent = fmt(need) + ' / ' + fmt(gb) + ' GB';
    }
    [b, p, g].forEach(function (el) { el.addEventListener('input', run); });
    run();
  })();
  </script>
</Base>
