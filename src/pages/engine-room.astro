---
// The Engine Room: the site's GPU corner. Linked from the front page and the KodeBox pop-up.
// It uses the site's own colours (light or dark), plus a few page styles in src/styles/engine-room.css.
// The KodeBox link is set in src/lib/site.ts.
import Base from '../layouts/Base.astro';
import '../styles/engine-room.css';
import { url } from '../lib/url';
import { KODEBOX, REPO } from '../lib/site';
import { benchLogs } from '../lib/benchlogs';

// 03 Start here: chapters from the notebooks, in the order a newcomer should read them.
const start = [
  { title: 'What a GPU is', why: 'Why a GPU suits model work, and what is inside one.', reads: [
    { nb: 'running-your-own-models', ch: '04-meet-the-gpu', from: 'Running Your Own Models · 4', title: 'Meet the GPU' },
    { nb: 'inside-the-machine', ch: '06-the-gpu', from: 'Inside the Machine · 6', title: 'The GPU: thousands of line cooks' },
  ] },
  { title: 'Memory decides what fits', why: 'Why GPU memory matters more than speed, and how to read the numbers.', reads: [
    { nb: 'inside-the-machine', ch: '07-the-real-bottleneck', from: 'Inside the Machine · 7', title: 'The real bottleneck' },
    { nb: 'inside-the-machine', ch: '11-reading-a-gpu-spec-sheet', from: 'Inside the Machine · 11', title: 'How to read a GPU spec sheet' },
  ] },
  { title: 'When you need more', why: 'More than one GPU, and GPUs shared by pods.', reads: [
    { nb: 'inside-the-machine', ch: '08-when-one-gpu-isnt-enough', from: 'Inside the Machine · 8', title: 'When one GPU isn’t enough' },
    { nb: 'running-your-own-models', ch: '07-models-on-kubernetes', from: 'Running Your Own Models · 7', title: 'Models on Kubernetes' },
  ] },
];
const latest = benchLogs[0];
const older = benchLogs.slice(1);
---
<Base title="The Engine Room: Nimesha's GPU Corner" page="hub" where="Nimesha's GPU Corner" description="The GPU corner of Ship It with Nimesha: Bench Logs from real GPU runs, a check for whether a model fits in GPU memory, and the chapters to read first.">
  <div slot="top" class="band hero-band er-top">
    <div class="wrap">
      <section class="hero er-hero er-hero-v4">
        <div class="er-hero-text">
          <p class="er-kicker"><span class="er-dot" aria-hidden="true"></span>Nimesha's GPU Corner</p>
          <h1 class="hero-title">The Engine Room</h1>
          <p class="hero-sub">Real runs on a real GPU, written up with every number. Plus a quick check for whether your model will fit.</p>
          <div class="er-cta">
            <a class="btn primary" href={url(`engine-room/logs/${latest.slug}/`)}>Read Bench Log #{latest.number}</a>
            <a class="btn" href="#fit">Will it fit?</a>
          </div>
          <dl class="er-facts">
            <div><dt>Bench Logs</dt><dd>{benchLogs.length}</dd></div>
            <div><dt>Latest run</dt><dd>{latest.date}</dd></div>
            <div><dt>GPU so far</dt><dd>NVIDIA T4</dd></div>
          </dl>
        </div>
        <figure class="er-console">
          <div class="er-console-bar" aria-hidden="true"><i></i><i></i><i></i><span>kk_user@will-it-fit</span></div>
          <pre><code><span class="c-cmd">$ nvidia-smi --query-gpu=name,memory.total,memory.used,driver_version --format=csv</span>
<span class="c-dim">name, memory.total [MiB], memory.used [MiB], driver_version</span>
Tesla T4, 15360 MiB, 0 MiB, 580.178.04
<span class="c-cmd">$ python3 bench2.py 65536</span>
== llama3.1:8b-instruct-q4_K_M  num_ctx=65536
Flash Attention enabled
K (f16): 4096.00 MiB
KV buffer size =  <span class="c-hi">8192.00 MiB</span>
V (f16): 4096.00 MiB
offloaded <span class="c-hi">33/33</span> layers to GPU
GPU memory used: 12901 MiB
run 1: prompt 23 tokens at 600 tok/s, wrote 128 tokens at <span class="c-hi">42.0 tok/s</span></code></pre>
          <figcaption>Output from the <a href={url('engine-room/logs/long-context/')}>Bench Log #2</a> run, 26 Nov 2026 (the 64K step, without the <code>ollama ps</code> line).</figcaption>
        </figure>
      </section>
    </div>
  </div>

  <section class="er-section" aria-labelledby="logs">
    <header class="er-head">
      <span class="er-idx">01</span>
      <h2 id="logs">Bench Logs</h2>
      <p class="er-status">A series <span aria-hidden="true">·</span> {benchLogs.length} {benchLogs.length === 1 ? 'log' : 'logs'} so far</p>
    </header>
    <p class="er-lead">Real runs on a real GPU, written up with every number, setting and screen.</p>
    <div class="series">
      <a class="series-main" href={url(`engine-room/logs/${latest.slug}/`)}>
        <div class="series-text">
          <span class="log-no">Latest <span aria-hidden="true">·</span> Log #{String(latest.number).padStart(2, '0')} <span aria-hidden="true">·</span> {latest.date}</span>
          <b class="series-title">{latest.title}</b>
          <span class="log-finding">{latest.finding}</span>
          <span class="log-kit">{latest.kit.map((k) => <span>{k}</span>)}</span>
          <span class="log-go">Read the log <span aria-hidden="true">&rarr;</span></span>
        </div>
        <div class="series-stats" aria-label={latest.statsNote}>
          <ul>
            {latest.stats.map((st) => (
              <li class={st.tone}><span>{st.label}</span><b>{st.value}</b><i style={`--w:${st.pct}%`}></i></li>
            ))}
          </ul>
          <p>{latest.statsNote}</p>
        </div>
      </a>
      <div class="series-next">
        <span class="log-no">Log #{String(latest.number + 1).padStart(2, '0')} <span aria-hidden="true">·</span> not run yet</span>
        <b>What should I run next?</b>
        <span class="log-finding">A model, a GPU question, something you want measured instead of guessed.</span>
        <a class="log-go" href={`${REPO}/issues/new?title=${encodeURIComponent('[Bench Log idea] ')}`}>Suggest a run <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
    {older.length > 0 && (
      <div class="series-earlier">
        <p class="series-label">Earlier logs</p>
        <ol class="series-grid">
          {older.map((l) => (
            <li>
              <a class="log-card" href={url(`engine-room/logs/${l.slug}/`)}>
                <span class="log-no">Log #{String(l.number).padStart(2, '0')} <span aria-hidden="true">·</span> {l.date}</span>
                <b class="log-title">{l.title}</b>
                <span class="log-finding">{l.finding}</span>
                <ul class="log-bars" aria-label={l.statsNote}>
                  {l.stats.map((st) => (
                    <li class={st.tone}><span>{st.label}</span><b>{st.value}</b><i style={`--w:${st.pct}%`}></i></li>
                  ))}
                </ul>
                <span class="log-go">Read log #{String(l.number).padStart(2, '0')} <span aria-hidden="true">&rarr;</span></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>

  <section class="er-section" aria-labelledby="fit">
    <header class="er-head">
      <span class="er-idx">02</span>
      <h2 id="fit">Will it fit?</h2>
    </header>
    <p class="er-lead">Weights take about 2 bytes each at 16-bit, 1.06 at 8-bit (q8_0) and 0.61 at 4-bit (q4_K_M). Add about 0.5 GB for the KV cache at a 4K context. <a href={url('engine-room/logs/will-it-fit/')}>Checked on a real T4 in Bench Log #1.</a></p>
    <form class="fit" id="fit-form" onsubmit="return false">
      <label>Model size (billions of parameters)
        <input type="number" id="fit-b" min="0.1" max="1000" step="0.1" value="8" inputmode="decimal" />
      </label>
      <label>Precision
        <select id="fit-p">
          <option value="2">16-bit (FP16 or BF16)</option>
          <option value="1.0625">8-bit (q8_0)</option>
          <option value="0.6125">4-bit (q4_K_M)</option>
        </select>
      </label>
      <label>GPU memory (GB)
        <input type="number" id="fit-g" min="1" max="1000" step="1" value="24" inputmode="numeric" />
      </label>
      <div class="vram" aria-hidden="true">
        <div class="vram-head"><span>VRAM</span><span id="fit-read">17 / 24 GB</span></div>
        <div class="vram-bar"><span id="fit-bar" style="width:69%"></span></div>
      </div>
      <output class="fit-out" id="fit-out" for="fit-b fit-p fit-g">An 8B model at 16-bit needs about 17 GB. It fits in 24 GB.</output>
    </form>
    <p class="small">A rough check for running a model, with one user and a 4K context. Longer contexts need more KV cache, and models with more layers need more per token. Full fine-tuning needs about 16 bytes per parameter, which is why most people fine-tune with LoRA or QLoRA.</p>
  </section>

  <section class="er-section" aria-labelledby="start">
    <header class="er-head">
      <span class="er-idx">03</span>
      <h2 id="start">Start here</h2>
    </header>
    <p class="er-lead">New to GPUs? Six chapters from the notebooks, in this order.</p>
    <ol class="path">
      {start.map((g, i) => (
        <li class="path-step">
          <span class="path-no">Step {i + 1}</span>
          <h3>{g.title}</h3>
          <p>{g.why}</p>
          <ul>
            {g.reads.map((r) => (
              <li><a href={url(`notebooks/${r.nb}/${r.ch}/`)}><span class="mn-from">{r.from}</span><b>{r.title}</b></a></li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <aside class="er-kb-strip" aria-label="Where I run my GPU work">
    <img src={url('kodebox-mark.png')} width="40" height="42" alt="KodeBox logo" />
    <p><b>Where I run these:</b> a KodeBox from KodeKloud, a server with an NVIDIA GPU that keeps running after I close my laptop. I work at KodeKloud.</p>
    <a class="btn" href={KODEBOX} target="_blank" rel="sponsored noopener" data-kb="engine-room">Start a KodeBox</a>
  </aside>

  <script is:inline>
  // Will it fit? Weights = parameters x bytes per weight (q4_K_M is about 4.9 bits, q8_0 about 8.5),
  // plus about 0.5 GB for the KV cache at a 4K context. Checked against a real T4 in Bench Log #1.
  (function () {
    var b = document.getElementById('fit-b'), p = document.getElementById('fit-p'), g = document.getElementById('fit-g'), out = document.getElementById('fit-out'), bar = document.getElementById('fit-bar'), read = document.getElementById('fit-read');
    if (!b) return;
    var names = { '2': '16-bit', '1.0625': '8-bit', '0.6125': '4-bit' };
    function fmt(n) { return n >= 10 ? Math.round(n) : Math.round(n * 10) / 10; }
    function run() {
      var bn = parseFloat(b.value), bytes = parseFloat(p.value), gb = parseFloat(g.value);
      if (!(bn > 0) || !(gb > 0)) { out.textContent = 'Type a model size and a GPU memory size.'; out.className = 'fit-out'; bar.style.width = '0'; read.textContent = ''; return; }
      var need = bn * bytes + 0.5, state = 'ok';
      var line = 'A ' + fmt(bn) + 'B model at ' + names[p.value] + ' needs about ' + fmt(need) + ' GB. ';
      if (need <= gb * 0.9) line += 'It fits in ' + fmt(gb) + ' GB.';
      else if (need <= gb) { line += 'It just fits in ' + fmt(gb) + ' GB, with little room for long conversations.'; state = 'tight'; }
      else {
        state = 'no';
        line += 'It does not fit in ' + fmt(gb) + ' GB.';
        line += bytes > 0.7 ? ' Try a smaller precision.' : ' Try a smaller model or a GPU with more memory.';
      }
      out.textContent = line;
      out.className = 'fit-out ' + state;
      bar.style.width = Math.min(100, need / gb * 100) + '%';
      bar.className = state;
      read.textContent = fmt(need) + ' / ' + fmt(gb) + ' GB';
    }
    [b, p, g].forEach(function (el) { el.addEventListener('input', run); });
    run();
  })();
  </script>
</Base>
