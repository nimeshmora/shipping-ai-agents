---
// The site front page: Ship It with Nimesha. Notebooks are listed in src/lib/notebooks.ts.
// It has a cleaner look than the notebooks (see src/styles/hub.css). The notebooks keep the Head First style.
import Base from '../layouts/Base.astro';
import Sketch from '../components/Sketch.astro';
import { url } from '../lib/url';
import { REPO, GOATCOUNTER, EXAMPLES, BUTTONDOWN, KODEBOX } from '../lib/site';
import KodeBoxPopup from '../components/KodeBoxPopup.astro';
import { notebooks } from '../lib/notebooks';
import Talks from '../components/Talks.astro';
import Subscribe from '../components/Subscribe.astro';
import HeroScene from '../components/HeroScene.astro';
import { allChapters } from '../lib/chapters';
import logo from '../../public/favicon.svg?raw';
const counts = Object.fromEntries(await Promise.all(notebooks.map(async (n) => [n.slug, (await allChapters(n.slug)).length])));
const topics = ['Where should my agent live?', 'AWS, Azure or Google Cloud?', 'How do I keep it safe, and what will it cost?', 'Should we run our own model?'];
const faq = [
  { q: 'Do I need cloud experience?', a: 'No. Every new word is explained the first time it appears.' },
  { q: 'Is it free?', a: 'Yes. Read it here or download the PDF.' },
  { q: 'Which clouds do you cover?', a: 'AWS, Microsoft Azure and Google Cloud.' },
];
---
<Base title="Ship It with Nimesha" page="hub">
  <section class="hero has-scene">
    <div class="hero-text">
    <p class="eyebrow">Free notebooks for people who build and run AI agents</p>
    <h1 class="hero-title">Ship It <span class="with">with</span> Nimesha</h1>
    <p class="hero-sub">Illustrated notes on deploying AI agents to AWS, Azure and Google Cloud.</p>
    <p class="hero-blurb">These notebooks explain how to move an AI agent from a prototype to a service that real people use. They cover where an agent and its model can run, how to secure them, how conversations and memory work, and what it all costs on each cloud. Each chapter has drawings, examples and short exercises.</p>
    <div class="actions">
      <a class="btn primary" href="#shelf">See the notebooks</a>
      <a class="btn" id="resume" href={url()} hidden>Continue reading</a>
      <a class="btn" href="#join-in">Contribute</a>
    </div>
    </div>
    <HeroScene />
    <div class="author">
      <span class="author-logo" aria-hidden="true" set:html={logo} />
      <p><b>By Nimesha Jinarajadasa</b><span>Writes about running AI agents in production.</span>{GOATCOUNTER && <span class="visits" id="visits" hidden><b id="visits-n"></b> visits so far</span>}</p>
    </div>
  {GOATCOUNTER && (
    <script is:inline define:vars={{ code: GOATCOUNTER }}>
    // Shows the total visits from GoatCounter. It stays hidden if the count can't be loaded
    // (for example while "Allow adding visitor counts on your website" is off in GoatCounter's settings).
    fetch('https://' + code + '.goatcounter.com/counter/TOTAL.json')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.count) return;
        document.getElementById('visits-n').textContent = d.count;
        document.getElementById('visits').hidden = false;
      })
      .catch(function () {});
    </script>
  )}
  </section>

  <section class="topics-wrap" aria-labelledby="topics">
    <h2 id="topics">Topics covered</h2>
    <ol class="topics">
      {topics.map((t) => <li>{t}</li>)}
    </ol>
  </section>

  <Talks slot="aside" compact />
  <KodeBoxPopup />
  <dialog class="stage-panel" id="share-the-stage" aria-labelledby="stage-title">
    <button class="stage-close" type="button" data-close-stage aria-label="Close">&times;</button>
    <div class="stage">
      <p class="stage-tag">Open to the community</p>
      <h2 id="stage-title">Share the stage</h2>
      <p>Schools, universities and meetups invite me to speak more often than I can say yes. If you help with these notebooks and you would like to speak, I would be glad to hand over a session to you, or to present it together.</p>
      <p>School students in IT, Maths, Biology and Technology streams are especially keen to meet people who work in software. A short, honest talk about your work can mean a lot to them.</p>
      <ul class="stage-list">
        <li>Take a session I can't attend</li>
        <li>Present one together with me</li>
        <li>Talk to school students who want to work in software</li>
      </ul>
      <div class="actions">
        <a class="btn primary" href={`${REPO}/issues/new?template=speaking.yml`}>Raise your hand to speak</a>
        <a class="btn" href="#join-in" data-close-stage>First, help with the notebooks</a>
      </div>
      <p class="small">Contributors come first. The form opens on GitHub and becomes a public issue, so please don't share your phone number or email there.</p>
    </div>
  </dialog>
  <script is:inline>
  // "Share the stage" opens as a panel from the right. Without JavaScript, the button links straight to the GitHub form.
  (function () {
    var panel = document.getElementById('share-the-stage');
    if (!panel || !panel.showModal) return;
    function open(e) { if (e) e.preventDefault(); if (!panel.open) panel.showModal(); history.replaceState(null, '', '#share-the-stage'); }
    function close() { panel.close(); }
    panel.addEventListener('close', function () { if (location.hash === '#share-the-stage') history.replaceState(null, '', location.pathname); });
    panel.addEventListener('click', function (e) { if (e.target === panel) close(); });
    document.querySelectorAll('[data-open-stage]').forEach(function (b) { b.addEventListener('click', open); });
    panel.querySelectorAll('[data-close-stage]').forEach(function (b) { b.addEventListener('click', close); });
    if (location.hash === '#share-the-stage') { open(); return; }
    // On the first front-page load of a visit, slide the panel in after a short pause.
    // sessionStorage remembers it for this tab, so it doesn't come back each time you return to the front page.
    var seen = false;
    try { seen = sessionStorage.getItem('stage-seen') === '1'; sessionStorage.setItem('stage-seen', '1'); } catch (e) {}
    // When the KodeBox pop-up shows on this visit, the panel waits for another visit.
    if (!seen && !window.kbPopup) setTimeout(function () { if (!panel.open) panel.showModal(); }, 1500);
  })();
  </script>
  <div slot="after">
    <div class="talks-inline"><Talks /></div>
    <section class="shelf" aria-labelledby="shelf">
      <h2 id="shelf">The notebooks</h2>
      {notebooks.map((n) => (
        <article class="nb">
          <a class="nb-cover" href={url(`notebooks/${n.slug}/`)} aria-hidden="true" tabindex="-1"><Sketch name={n.cover} /></a>
          <div class="nb-body">
            <p class="nb-no">Notebook #{n.number}</p>
            <h3><a href={url(`notebooks/${n.slug}/`)}>{n.title}</a></h3>
            <p>{n.blurb}</p>
            <p class="nb-meta">{counts[n.slug]} chapters{n.pdf && <> and a PDF</>}. {n.edition}.</p>
            <div class="actions">
              <a class="btn primary" href={url(`notebooks/${n.slug}/how/`)}>Start reading</a>
              <a class="btn" href={url(`notebooks/${n.slug}/`)}>See the chapters</a>
              {n.pdf && <a class="btn" href={url(n.pdf)}>PDF</a>}
              {n.examples && <a class="btn" href={`${EXAMPLES}/${n.examples}`}>{n.examplesButton ?? 'Get the code'}</a>}
            </div>
          </div>
        </article>
      ))}
      <article class="nb next">
        <div class="nb-body">
          <p class="nb-no">Notebook #{notebooks.length + 1}</p>
          <h3>Not started yet</h3>
          <p>Which topic should come next? Suggestions are welcome.</p>
          <div class="actions"><a class="btn" href={`${REPO}/issues/new?template=chapter-idea.yml`}>Suggest a topic</a></div>
        </div>
      </article>
    </section>

    <section class="gpu-corner" aria-labelledby="gpu-corner">
      <div class="gpu-corner-text">
        <p class="eyebrow">The GPU corner</p>
        <h2 id="gpu-corner">Want to try GPU work at home?</h2>
        <p>Most laptops can't train a model, and buying a GPU to learn on costs a lot. The Engine Room has the commands to run on your first GPU server, a check for whether a model will fit in GPU memory, and the chapters to read first.</p>
        <div class="actions">
          <a class="btn primary" href={url('engine-room/')}>Go to the Engine Room</a>
          <a class="btn" href={KODEBOX} target="_blank" rel="sponsored noopener" data-kb="front-page">Start a KodeBox</a>
        </div>
      </div>
      <div class="gpu-corner-kb">
        <img src={url('kodebox-mark.png')} width="72" height="76" alt="KodeBox logo" />
        <p><b>KodeBox</b>I use KodeBox from KodeKloud for this. It is a server that stays up until you stop it, with a GPU when you ask for one.</p>
      </div>
    </section>

    {(BUTTONDOWN || import.meta.env.DEV) && <div class="sub-wrap"><Subscribe where="front-page" /></div>}

    <section class="join" id="join-in" aria-labelledby="join-title">
      <div>
        <h2 id="join-title">Help improve the notebooks</h2>
        <p>Most kinds of help don't need any code.</p>
        <ul class="join-list">
          <li><b>Share an example</b>, such as code, a diagram or something you ran into in production. <a href={`${REPO}/issues/new?template=example.yml`}>Suggest it</a></li>
          <li><b>Report a mistake</b> or a fact that is out of date. <a href={`${REPO}/issues/new?template=fix.yml`}>Report it</a></li>
          <li><b>Fix it yourself</b> with the <i>Edit this page</i> link at the end of each chapter.</li>
          <li><b>Read the</b> <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>contributing guide</a> before you send a larger change.</li>
        </ul>
      </div>
      <div>
        <h2>Questions</h2>
        <dl class="faq">
          {faq.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}
          <dt>Can I share it with my team?</dt>
          <dd>Yes, with credit. You may not sell it. The <a href={`${REPO}/blob/main/LICENSE-CONTENT.md`}>license</a> has the details.</dd>
        </dl>
      </div>
      <p class="byline"><b>Nimesha Jinarajadasa</b>, author of these notebooks. <a href={REPO}>See the project on GitHub</a></p>
    </section>
  </div>
</Base>
