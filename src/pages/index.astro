---
// The site front page: Ship It with Nimesha. Notebooks are listed in src/lib/notebooks.ts.
import Base from '../layouts/Base.astro';
import Sketch from '../components/Sketch.astro';
import Strip from '../components/Strip.astro';
import YourTurn from '../components/YourTurn.astro';
import NoSillyQuestions from '../components/NoSillyQuestions.astro';
import QA from '../components/QA.astro';
import { url } from '../lib/url';
import { REPO, GOATCOUNTER } from '../lib/site';
import { notebooks } from '../lib/notebooks';
import Talks from '../components/Talks.astro';
import { allChapters } from '../lib/chapters';
const counts = Object.fromEntries(await Promise.all(notebooks.map(async (n) => [n.slug, (await allChapters(n.slug)).length])));
---
<Base title="Ship It with Nimesha" page="hub">
  <div class="hero-top">
    <div>
      <p class="kick">AI agents &middot; deployment &middot; infrastructure</p>
      <h1 class="hero-title">Ship It<br /><span class="with">with</span> Nimesha</h1>
      <p class="hero-sub">Illustrated notes on deploying AI agents to AWS, Azure and Google Cloud.</p>
    </div>
    <div class="badge">Free to read</div>
  </div>

  <Strip who="nimesha" text="Hi, I'm Nimesha. I write about running AI agents in production." />

  <p class="hero-blurb">These notebooks explain how to move an AI agent from a prototype to a service that real people use. They cover where an agent and its model can run, how to secure them, how conversations and memory work, and what it all costs on each cloud. Each chapter has drawings, examples and short exercises.</p>

  <div class="actions">
    <a class="btn primary" href={url(`notebooks/${notebooks[0].slug}/how/`)}>Read Notebook #1</a>
    <a class="btn" id="resume" href={url()} hidden>Continue reading</a>
    <a class="btn" href="#join-in">Contribute</a>
  </div>
  {GOATCOUNTER && <p class="visits" id="visits" hidden><span aria-hidden="true">👀</span> <b id="visits-n"></b> visits so far</p>}
  {GOATCOUNTER && (
    <script is:inline define:vars={{ code: GOATCOUNTER }}>
    // Shows the total visits from GoatCounter. It stays hidden if the count can't be loaded
    // (for example while "Allow adding visitor counts on your website" is off in GoatCounter's settings).
    fetch('https://' + code + '.goatcounter.com/counter/TOTAL.json')
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.count) return;
        document.getElementById('visits-n').textContent = d.count;
        document.getElementById('visits').hidden = false;
      })
      .catch(function () {});
    </script>
  )}

  <h2><span>Topics covered</span></h2>
  <div class="topics">
    <div class="sticky">Where should my agent live?</div>
    <div class="sticky r blue">AWS, Azure or Google Cloud?</div>
    <div class="sticky pink">How do I keep it safe, and what will it cost?</div>
    <div class="sticky r green">Should we run our own model?</div>
  </div>

  <Talks slot="aside" compact />
  <dialog class="stage-panel" id="share-the-stage" aria-labelledby="stage-title">
    <button class="stage-close" type="button" data-close-stage aria-label="Close">&times;</button>
    <div class="stage">
      <p class="stage-tag">Open to the community</p>
      <h2 id="stage-title"><span>Share the stage</span></h2>
      <p>Schools, universities and meetups invite me to speak more often than I can say yes. If you help with these notebooks and you would like to speak, I would be glad to hand over a session to you, or to present it together.</p>
      <p>School students in IT, Maths, Biology and Technology streams are especially keen to meet people who work in software. A short, honest talk about your work can mean a lot to them.</p>
      <div class="two stage-notes">
        <div class="sticky">Take a session I can't attend</div>
        <div class="sticky r blue">Present one together with me</div>
        <div class="sticky green">Talk to school students who want to work in software</div>
      </div>
      <div class="actions">
        <a class="btn primary" href={`${REPO}/issues/new?template=speaking.yml`}>Raise your hand to speak</a>
        <a class="btn" href="#join-in" data-close-stage>First, help with the notebooks</a>
      </div>
      <p class="small">Contributors come first. The form opens on GitHub and becomes a public issue, so please don't share your phone number or email there.</p>
    </div>
  </dialog>
  <script is:inline>
  // "Share the stage" opens as a panel from the right. Without JavaScript, the button links straight to the GitHub form.
  (function () {
    var panel = document.getElementById('share-the-stage');
    if (!panel || !panel.showModal) return;
    function open(e) { if (e) e.preventDefault(); if (!panel.open) panel.showModal(); history.replaceState(null, '', '#share-the-stage'); }
    function close() { panel.close(); }
    panel.addEventListener('close', function () { if (location.hash === '#share-the-stage') history.replaceState(null, '', location.pathname); });
    panel.addEventListener('click', function (e) { if (e.target === panel) close(); });
    document.querySelectorAll('[data-open-stage]').forEach(function (b) { b.addEventListener('click', open); });
    panel.querySelectorAll('[data-close-stage]').forEach(function (b) { b.addEventListener('click', close); });
    if (location.hash === '#share-the-stage') open();
  })();
  </script>
  <div slot="after">
    <div class="talks-inline"><Talks /></div>
    <section class="paper shelf" aria-labelledby="shelf">
      <h2 id="shelf"><span>The notebooks</span></h2>
      {notebooks.map((n) => (
        <article class="nb">
          <a class="nb-cover" href={url(`notebooks/${n.slug}/`)} aria-hidden="true" tabindex="-1"><Sketch name={n.cover} /></a>
          <div class="nb-body">
            <p class="nb-no">Notebook #{n.number}</p>
            <h3><a href={url(`notebooks/${n.slug}/`)}>{n.title}</a></h3>
            <p>{n.blurb}</p>
            <p class="nb-meta">{counts[n.slug]} chapters{n.pdf && <> &middot; PDF</>} &middot; {n.edition}</p>
            <div class="actions">
              <a class="btn primary" href={url(`notebooks/${n.slug}/how/`)}>Start reading</a>
              <a class="btn" href={url(`notebooks/${n.slug}/`)}>See the chapters</a>
              {n.pdf && <a class="btn" href={url(n.pdf)}>PDF</a>}
            </div>
          </div>
        </article>
      ))}
      <article class="nb next">
        <div class="nb-body">
          <p class="nb-no">Notebook #{notebooks.length + 1}</p>
          <h3>Not started yet</h3>
          <p>Which topic should come next? Suggestions are welcome.</p>
          <div class="actions"><a class="btn" href={`${REPO}/issues/new?template=chapter-idea.yml`}>Suggest a topic</a></div>
        </div>
      </article>
    </section>

    <section class="paper" id="join-in">
      <YourTurn>
        <p>You can help improve these notebooks. Most kinds of help don't need any code.</p>
        <ul class="check">
          <li><b>Share an example</b>, such as code, a diagram or something you ran into in production. <a href={`${REPO}/issues/new?template=example.yml`}>Suggest it</a></li>
          <li><b>Report a mistake</b> or a fact that is out of date. <a href={`${REPO}/issues/new?template=fix.yml`}>Report it</a></li>
          <li><b>Fix it yourself</b> with the <i>Edit this page</i> link at the end of each chapter.</li>
          <li><b>Read the</b> <a href={`${REPO}/blob/main/CONTRIBUTING.md`}>contributing guide</a> before you send a larger change.</li>
        </ul>
      </YourTurn>

      <NoSillyQuestions>
        <QA q="Do I need cloud experience?">No. Every new word is explained the first time it appears.</QA>
        <QA q="Is it free?">Yes. Read it here or download the PDF.</QA>
        <QA q="Which clouds do you cover?">AWS, Microsoft Azure and Google Cloud.</QA>
        <QA q="Can I share it with my team?">Yes, with credit. You may not sell it. The <a href={`${REPO}/blob/main/LICENSE-CONTENT.md`}>license</a> has the details.</QA>
      </NoSillyQuestions>

      <p class="byline"><b>Nimesha Jinarajadasa</b><br />Author &middot; <a href={REPO}>on GitHub</a></p>
    </section>
  </div>
</Base>
